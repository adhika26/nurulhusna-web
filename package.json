{
  "name": "nurulhusna-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:seed-dummy": "npx tsx scripts/seed-dummy.ts",
    "db:seed-biaya": "npx tsx scripts/seed-biaya.ts",
    "db:import-wilayah": "npx tsx scripts/import-wilayah.ts",
    "create:admin": "npx tsx scripts/create-admin.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.3.2",
    "@sveltejs/kit": "^2.43.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.4",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.35.5",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@lucide/svelte": "^1.68.0",
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.44.5",
    "marked": "^18.1.3",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  }
}
